#!/bin/sh
# Keep recovery worktree-local: never use the repository-global stash.
# exec also makes signal handling independent of Husky's sh -e wrapper.
exec node --input-type=module <<'NODE'
import { spawn, execFileSync } from 'node:child_process'
import * as fs from 'node:fs'
import { join, dirname, resolve } from 'node:path'
import { tmpdir } from 'node:os'

const git = (...args) => execFileSync('git', args, { encoding: 'utf8' }).trimEnd()
process.chdir(git('rev-parse', '--show-toplevel'))
const backup = fs.mkdtempSync(join(tmpdir(), 'pre-commit-snapshot-'))
const index = resolve(git('rev-parse', '--git-path', 'index'))
const gitDir = resolve(git('rev-parse', '--absolute-git-dir'))
const records = []
let ready = false
let signalStatus = 0
let child
const signals = { SIGHUP: 129, SIGINT: 130, SIGTERM: 143 }
for (const [signal, status] of Object.entries(signals)) {
  process.on(signal, () => {
    signalStatus ||= status
    if (child) {
      try { process.kill(-child.pid, signal) } catch (error) {
        if (error.code !== 'ESRCH') console.error(error)
      }
    }
  })
}

function capture(path) {
  const destination = join(backup, String(records.length))
  let stat
  try { stat = fs.lstatSync(path) } catch (error) {
    if (error.code !== 'ENOENT') throw error
  }
  // Submodules/directories are not formatter inputs; do not traverse them.
  if (stat?.isDirectory()) return
  const record = { path, destination, mode: stat?.mode, missing: !stat }
  if (stat?.isSymbolicLink()) record.link = fs.readlinkSync(path)
  else if (stat) fs.copyFileSync(path, destination)
  records.push(record)
}

function restoreFiles(files) {
  // Restore only bytes actually captured; never checkout unrelated files.
  for (const record of files) {
    if (record.missing) fs.rmSync(record.path, { force: true })
    else {
      fs.mkdirSync(dirname(record.path), { recursive: true })
      fs.rmSync(record.path, { force: true })
      if (record.link !== undefined) fs.symlinkSync(record.link, record.path)
      else {
        fs.copyFileSync(record.destination, record.path)
        fs.chmodSync(record.path, record.mode)
      }
    }
  }
}

function restore() {
  restoreFiles(records)
  // The raw index preserves content, stages and assume-unchanged/skip-worktree
  // flags. No diff/apply or user whitespace policy participates in recovery.
  fs.copyFileSync(join(backup, 'index'), `${index}.cw758-restore`)
  fs.renameSync(`${index}.cw758-restore`, index)
}

let status = 1
try {
  fs.copyFileSync(index, join(backup, 'index'))
  const paths = execFileSync('git', ['diff', '--cached', '--name-only', '-z', '--diff-filter=ACMRD', '--no-renames'], { encoding: 'utf8' }).split('\0').filter(Boolean)
  for (const path of paths) capture(resolve(path))
  for (const name of ['MERGE_HEAD', 'MERGE_MODE', 'MERGE_MSG', 'lint-staged_unstaged.patch']) capture(join(gitDir, name))
  fs.writeFileSync(join(backup, 'manifest.json'), JSON.stringify({ index, records }, null, 2))
  ready = true
  if (!signalStatus) {
    child = spawn('npx', ['lint-staged', '--no-stash'], { stdio: 'inherit', detached: true })
    status = await new Promise((resolve, reject) => {
      child.once('error', reject)
      child.once('close', code => resolve(code ?? 1))
    })
  }
  status = signalStatus || status
  if (status) restore()
  else restoreFiles(records.filter(record => record.path === join(gitDir, 'lint-staged_unstaged.patch')))
  fs.rmSync(backup, { recursive: true, force: true })
} catch (error) {
  console.error('pre-commit:', error)
  if (ready) {
    try { restore() } catch (recoveryError) { console.error('pre-commit recovery:', recoveryError) }
  }
  console.error(`pre-commit: recovery snapshot kept at ${backup}`)
  status = signalStatus || 1
}
process.exitCode = status
NODE
