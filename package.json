  "name": "coach",
  "engines": {
    "node": ">=24.11.0 <25.0.0"
  },
  "private": true,
  "scripts": {
    "backfill:provider-subscriptions": "tsx scripts/backfill-provider-subscriptions.ts",
    "backfill-scores": "tsx scripts/backfill-scores.ts",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:mcp": "vitest run --config vitest.mcp.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:lighthouse": "gtimeout 180s lhci autorun || timeout 180s lhci autorun || lhci autorun",
    "e2e:lighthouse": "gtimeout 180s lhci autorun || timeout 180s lhci autorun || lhci autorun",
    "e2e:lighthouse:verbose": "gtimeout 180s lhci autorun --log-level=verbose || timeout 180s lhci autorun --log-level=verbose || lhci autorun --log-level=verbose",
    "e2e:lighthouse:dev": "E2E_BASE_URL=http://localhost:3000 gtimeout 180s lhci autorun || E2E_BASE_URL=http://localhost:3000 lhci autorun",
    "e2e:up": "docker compose --env-file .env.e2e -p ${E2E_PROJECT:-coach-e2e} -f docker-compose.e2e.yml up -d --wait",
    "e2e:up:infra": "docker compose --env-file .env.e2e -p ${E2E_PROJECT:-coach-e2e} -f docker-compose.e2e.yml up -d --wait postgres-e2e redis-e2e",
    "e2e:down": "docker compose --env-file .env.e2e -p ${E2E_PROJECT:-coach-e2e} -f docker-compose.e2e.yml down",
    "e2e:down:wipe": "docker compose --env-file .env.e2e -p ${E2E_PROJECT:-coach-e2e} -f docker-compose.e2e.yml down -v",
    "e2e:build": "docker compose --env-file .env.e2e -p ${E2E_PROJECT:-coach-e2e} -f docker-compose.e2e.yml build app-e2e",
    "e2e:db:up": "pnpm e2e:up:infra",
    "e2e:db:down": "pnpm e2e:down",
    "e2e:db:prepare": "tsx e2e/scripts/prepare-db.ts",
    "e2e:reset": "tsx e2e/scripts/prepare-db.ts",
    "e2e:app:host": "tsx e2e/scripts/run-app-host.ts",
    "e2e:setup": "bash ./scripts/e2e-setup.sh",
    "e2e:sync": "bash e2e/scripts/sync-to-mini.sh",
    "e2e:checkout": "bash e2e/scripts/checkout-on-mini.sh",
    "e2e:remote": "bash e2e/scripts/run-on-mini.sh",
    "e2e:remote:branch": "bash e2e/scripts/run-on-mini-branch.sh",
    "e2e:remote:up": "bash e2e/scripts/remote-up.sh",
    "e2e:remote:ui": "bash e2e/scripts/ui-remote.sh",
    "e2e:tunnel": "bash e2e/scripts/tunnel-to-mini.sh",
    "e2e:tunnel:stop": "bash e2e/scripts/tunnel-to-mini.sh stop",
    "build": "prisma generate && nuxt build",
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' nuxt dev",
    "dev:worker": "NODE_ENV=development NODE_OPTIONS='--max-old-space-size=8192' tsx watch cli/worker/index.ts start",
    "dev:trigger": "pnpm prisma:generate && npx trigger.dev@latest dev",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' nuxt typecheck --checker=vue-tsc",
    "typecheck:prepare": "nuxt prepare",
    "typecheck:fast": "NODE_OPTIONS='--max-old-space-size=8192' vue-tsc -b --noEmit",
    "typecheck:app": "NODE_OPTIONS='--max-old-space-size=8192' vue-tsc -p .nuxt/tsconfig.app.json --noEmit",
    "typecheck:server": "NODE_OPTIONS='--max-old-space-size=8192' tsc -p .nuxt/tsconfig.server.json --noEmit",
    "typecheck:watch": "NODE_OPTIONS='--max-old-space-size=8192' vue-tsc -b --noEmit --watch",
    "typecheck:diagnostics": "NODE_OPTIONS='--max-old-space-size=8192' vue-tsc -b --noEmit --extendedDiagnostics",
    "format": "prettier --write .",
    "postinstall": "prisma generate",
    "preview": "nuxt preview",
    "prisma:generate": "prisma generate",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "cli": "tsx ./cli/index.ts",
    "cw:cli": "tsx cli/index.ts",
    "cw:cli:chatroom": "tsx cli/index.ts debug chatroom",
    "cw:cli:nutrition:day-log": "tsx cli/index.ts nutrition day-log",
    "cw:cli:nutrition:review-glycogen": "tsx cli/index.ts nutrition review-glycogen",
    "cw:cli:nutrition:debug": "tsx cli/index.ts nutrition debug-metabolic",
    "cw:cli:nutrition:metabolic": "tsx cli/index.ts nutrition metabolic",
    "cw:cli:fueling:debug": "tsx cli/index.ts nutrition chain",
    "cw:cli:fueling:workout": "tsx cli/index.ts nutrition fueling-workout",
    "cw:cli:fueling:compare": "tsx cli/index.ts nutrition compare-fueling",
    "cw:worker": "NODE_OPTIONS='--max-old-space-size=8192' tsx cli/worker/index.ts",
    "db:deploy": "prisma migrate deploy",
    "db:dump": "scripts/dump-db.sh",
    "db:dump:prod": "scripts/dump-db.sh DATABASE_URL_PROD",
    "prepare": "husky || true",
    "i18n:pull": "node -e \"require('dotenv').config(); require('child_process').spawn('tolgee', ['pull', '--api-url', process.env.TOLGEE_API_URL], { stdio: 'inherit', shell: true })\"",
    "i18n:push": "node -e \"require('dotenv').config(); require('child_process').spawn('tolgee', ['push', '--api-url', process.env.TOLGEE_API_URL], { stdio: 'inherit', shell: true })\""
  },
  "type": "module",
  "version": "0.5.25",
  "onlyBuiltDependencies": [
    "@parcel/watcher",
    "@prisma/client",
    "@prisma/engines",
    "@sentry/cli",
    "bcrypt",
    "better-sqlite3",
    "esbuild",
    "msgpackr-extract",
    "prisma",
    "unrs-resolver"
  ],
  "overrides": {
    "ai": "$ai",
    "@vercel/nft": "^0.27.4",
    "@vueuse/core": "^14.3.0",
    "@vueuse/shared": "^14.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.17.0"
}
